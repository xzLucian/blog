# 环境变量

# 版本号
VITE_VERSION = 3.0.1

# 端口号
VITE_PORT = 3006

# 应用部署基础路径
VITE_BASE_URL = /

# API 请求基础路径
VITE_API_URL = /

# 代理目标地址（Vite 代理转发请求到此地址）
VITE_API_PROXY_URL = http://localhost:3000

# 权限模式
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 是否移除 console
VITE_DROP_CONSOLE = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro
